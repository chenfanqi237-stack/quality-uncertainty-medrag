{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/quality-uncertainty-medrag/question_prediction.schema.json",
  "title": "Question prediction",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_id", "predicted_option_label", "option_scores"],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "predicted_option_label": {"type": "string", "minLength": 1},
    "option_scores": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"type": "number"}
    }
  }
}

